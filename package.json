{
  "name": "dsh-model-console",
  "version": "0.2.2",
  "description": "A truthful model control surface for DeepSeek Harness: live providers, local Codex authentication, and safe Qwen configuration.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./typert": {
      "default": "./lib/typert.host.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run test && npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "models",
    "codex",
    "qwen"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChangfengHU/dsh-model-console.git"
  },
  "homepage": "https://github.com/ChangfengHU/dsh-model-console#readme",
  "bugs": {
    "url": "https://github.com/ChangfengHU/dsh-model-console/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent-default-model": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-subprocess": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.8 <0.2.0",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "tsx": "^4.20.6"
  },
  "engines": {
    "node": ">=20"
  }
}
